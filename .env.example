# ---------------------------------------------------------------------------
# NDEL website: environment variables
# Copy to .env and fill in. Never commit .env. All values are server-only;
# none are exposed to the browser (no NEXT_PUBLIC_ variables are used).
# ---------------------------------------------------------------------------

# Required. PostgreSQL connection string.
# Local dev (npm run db:start): postgres://ndel:ndel-local-dev@localhost:5433/ndel
DATABASE_URL=

# Required. Long random string used to sign Payload sessions and the demo-access cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Public base URL, no trailing slash. Used for metadata, the sitemap and email links.
SITE_URL=http://localhost:3000

# --- Proposal demonstration controls ----------------------------------------
# Password visitors must enter to view the site. Required in production
# while SITE_MODE=demo; if blank in production the site refuses access.
DEMO_ACCESS_PASSWORD=
# "demo" = password-protected, noindex, shows labelled sample content.
# "live" = public, indexable, shows only content marked "Verified".
SITE_MODE=demo

# --- Seed accounts (npm run seed only) ---------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_EDITOR_EMAIL=editor@example.com
SEED_EDITOR_PASSWORD=

# --- Email notifications (optional; NOT configured by default) ----------------
# When SMTP_HOST is blank, enquiries are saved and the visitor is told that
# no email notification was sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=NDEL Website
# Staff inbox that receives new-enquiry notifications.
ENQUIRY_NOTIFICATION_EMAIL=

# --- S3-compatible storage (optional; production uploads) ---------------------
# When S3_BUCKET is blank, uploads are stored on local disk:
#   media/  documents/  private-uploads/enquiries/
# Enquiry attachments are always served through Payload's access control,
# never by direct public bucket URL. Keep the bucket private.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
